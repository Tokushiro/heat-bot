# =================================
# HEAT Bot Environment Configuration
# =================================

# -------------------------
# Hardware Mode
# -------------------------
# Switch between real hardware and mock implementations
# - true: Use mock hardware (for testing without physical devices)
# - false: Use real hardware (for production with actual robot and sensor)
USE_MOCK_HARDWARE=true

# -------------------------
# Database Configuration
# -------------------------
POSTGRES_USER=oskar
POSTGRES_PASSWORD=123456789
POSTGRES_DB=heatbot
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# -------------------------
# Server Configuration
# -------------------------
SERVER_PORT=3000
SERVER_IP=192.168.56.1
NODE_ENV=development

# -------------------------
# Real Hardware Configuration
# (Only used when USE_MOCK_HARDWARE=false)
# -------------------------

# Serial Port for Robot
SERIAL_PORT=/dev/ttyUSB0
SERIAL_BAUD_RATE=115200

# BLE Sensor
BLE_SENSOR_MAC=aa:bb:cc:dd:ee:ff
BLE_SCAN_TIMEOUT=10000

# -------------------------
# Mock Hardware Configuration
# (Only used when USE_MOCK_HARDWARE=true)
# -------------------------

# Mock Robot Settings
MOCK_BATTERY_DRAIN_PER_MOVE=0.5
MOCK_MOVEMENT_DELAY_MS=1500
MOCK_CONNECTION_DELAY_MS=500

# Mock Sensor Settings
MOCK_DETECTION_PROBABILITY=0.85
MOCK_DETECTION_DELAY_MS=1500

# -------------------------
# Test Configuration
# -------------------------

# Checkpoint frequency (save every N measurements)
CHECKPOINT_SAVE_FREQUENCY=10

# Retry settings
MAX_RETRY_ATTEMPTS=3
RETRY_DELAY_MS=2000

# -------------------------
# Logging
# -------------------------
LOG_LEVEL=info
ENABLE_DEBUG_LOGS=false
