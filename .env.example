# POSTGRES
POSTGRES_USER=oskar
POSTGRES_PASSWORD=123456789
POSTGRES_DB=heatbot
POSTGRES_PORT=5432

# SERVER
SERVER_PORT=3000
SERVER_IP=localhost    # Change to your server IP

# TIMEZONE
TZ=Europe/Copenhagen  # Change to your timezone

# Change to your robot serial port
# /dev/ttyUSB0 for Linux
# COM for Windows
ROBOT_SERIAL_PORT=/dev/ttyUSB0  # Change to your robot serial port


# SENSOR

BLE_SENSOR_MAC=10:B9:F7:11:62:CF # Change to your sensor MAC address

USE_MOCK_SENSOR=true # Set to "true" to use mock sensor (simulated detection), "false" to use real BLE sensor


# ROBOT
USE_MOCK_ROBOT=false # Set to "true" to use mock robot (no real hardware), "false" to use real robot

# STAND (Rotating detector platform)
# All commands sent through robot's SerialManager - no separate port needed
USE_MOCK_STAND=true # Set to "true" to use mock stand (simulated rotation), "false" to use real stand

# HEATING (Thermal manikin temperature control)
# All commands sent through robot's SerialManager - no separate port needed
USE_MOCK_HEATING=true # Set to "true" to use mock heating (simulated temperatures), "false" to use real heating

# ENVIRONMENT (Temperature and humidity monitoring)
# All commands sent through robot's SerialManager - no separate port needed
USE_MOCK_ENVIRONMENT=true # Set to "true" to use mock sensor (simulated readings), "false" to use real sensor

# GRID TEST (Grid-based movement testing)
# Uses robot's SerialManager for movement commands - no separate port needed
USE_MOCK_GRIDTEST=true # Set to "true" to use mock system (simulated movement), "false" to use real robot

# Simulation Speed Multiplier - Speed up testing and development
# Valid values: 1, 2, 3, 4, 5, 10
# 1 = Normal speed (default)
# 2 = 2x faster (all delays and intervals halved)
# 10 = 10x faster (e.g., 30s heating stabilization becomes 3s)
SIMULATION_SPEED=1
